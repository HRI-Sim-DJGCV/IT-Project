# Copy to server/.env and fill in. Never commit .env.

# Google Maps Platform key with Routes API, Places API (New), Elevation API and Weather API enabled.
GOOGLE_MAPS_API_KEY=

# OpenAI key used to write each walk's meditation script.
OPENAI_API_KEY=

# Shared secret the Node API sends as X-Internal-Key. Leave empty in local dev; set the same value as
# backend/.env AI_INTERNAL_KEY in any deployed environment.
INTERNAL_KEY=

# Text-to-speech. Set TTS_ENABLED=false to run without loading the model (routes and scripts still work;
# audio generation returns 503).
TTS_ENABLED=true
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

PORT=8001
