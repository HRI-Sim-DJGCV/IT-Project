# Copy to server/.env and fill in. Never commit .env.

# Google Maps Platform key with Routes API, Places API (New), Elevation API and Weather API enabled.
GOOGLE_MAPS_API_KEY=

# OpenAI key used to write each walk's meditation script.
OPENAI_API_KEY=

# Shared secret the Node API sends as X-Internal-Key. Leave empty in local dev; set the same value as
# backend/.env AI_INTERNAL_KEY in any deployed environment.
INTERNAL_KEY=

# Text-to-speech (Google Cloud Text-to-Speech, Neural2 voices). Enable the "Cloud Text-to-Speech
# API" on the Google Cloud project this key belongs to; a billing account must be linked but the
# Neural2 free tier (1 million characters/month) is not billed while you stay under it.
# Set TTS_ENABLED=false to skip the check (routes and scripts still work; audio generation returns 503).
TTS_ENABLED=true

# Optional: only needed if Cloud Text-to-Speech should use a different key/project than
# GOOGLE_MAPS_API_KEY above.
GOOGLE_TTS_API_KEY=

PORT=8001
