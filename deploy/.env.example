# Copy to deploy/.env on the EC2 instance and fill in. Never commit deploy/.env.

# Public hostname Caddy gets a TLS certificate for (Elastic IP via sslip.io)
API_HOST=32-236-180-226.sslip.io

# MongoDB Atlas (allow the Elastic IP 32.236.180.226 in Atlas Network Access)
MONGODB_URI=
MONGODB_DB_NAME=walkingapp

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# The Vercel frontend origin(s), comma-separated
CORS_ORIGINS=https://your-app.vercel.app

GOOGLE_MAPS_API_KEY=

# Only needed once the real AI service replaces the stub (see deploy/README.md)
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
AI_INTERNAL_KEY=
INTERNAL_KEY=
