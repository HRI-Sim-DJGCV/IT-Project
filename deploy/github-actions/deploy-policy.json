{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunDeployOnTheInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:165328640519:instance/i-085e917feb2ee6886",
        "arn:aws:ssm:ap-southeast-2::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadDeployStatus",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ec2:DescribeInstances"],
      "Resource": "*"
    }
  ]
}
