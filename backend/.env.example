# Copy this file to backend/.env and fill in the values. Never commit .env.

# Atlas > Database > Connect > Drivers. Use a DATABASE user (Security > Database Access), not your Atlas login.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
# For a throwaway local database instead: docker compose up mongo, then mongodb://localhost:27017
MONGODB_URI=

# Database inside the cluster. The team's cluster already has "walkingapp".
MONGODB_DB_NAME=walkingapp

# Long random string for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime. Do not go below 2h: a 45-minute walk plus surveys must fit inside it.
JWT_EXPIRES_IN=24h

# API port. Frontend expects http://localhost:8000/v1 in dev.
PORT=8000

# Comma-separated browser origins allowed by CORS. *.vercel.app previews are always allowed.
CORS_ORIGINS=http://localhost:5173

# Server-side Google Maps API key: Geocoding + Routes APIs. Enable both in Google Cloud.
# Restrict this key to those APIs and keep it out of frontend code.
GOOGLE_MAPS_API_KEY=

# The internal Python AI service (server/): routes, script generation, text-to-speech.
# Only this API talks to it; the app never does.
AI_SERVICE_URL=http://localhost:8001
# Optional shared secret. If set, put the same value in server/.env as INTERNAL_KEY.
AI_INTERNAL_KEY=
# Script + audio generation can take several minutes on CPU.
AI_TIMEOUT_MS=900000

# Where generated mp3 files are stored (one folder per walk preparation).
AUDIO_DIR=./data/audio
