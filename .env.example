# Copy this file to .env at the repository root. Never commit .env.
#
# One file feeds everything: the Node API (backend/), the web app (frontend/,
# which only sees VITE_* variables) and docker compose. A backend/.env, if you
# have one, still overrides these values for the API. The Python AI service
# keeps its own server/.env (different runtime, different keys).

# ---------------------------------------------------------------- Node API --

# Atlas > Database > Connect > Drivers. Use a DATABASE user (Security > Database Access), not your Atlas login.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
# For a throwaway local database instead: docker compose up mongo, then mongodb://localhost:27017
MONGODB_URI=

# Database inside the cluster. The team's cluster already has "walkingapp".
MONGODB_DB_NAME=walkingapp

# Long random string for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime. Do not go below 2h: a 45-minute walk plus surveys must fit inside it.
JWT_EXPIRES_IN=24h

# API port. Frontend expects http://localhost:8000/v1 in dev.
PORT=8000

# Comma-separated browser origins allowed by CORS. *.vercel.app previews are always allowed.
CORS_ORIGINS=http://localhost:5173

# Server-side Google Maps key: Geocoding API + Routes API. Enable both in Google Cloud,
# restrict the key to those APIs, and keep it out of frontend code. Route generation
# returns an error until this is set; everything else works without it.
GOOGLE_MAPS_API_KEY=

# The internal Python AI service (server/): script generation and text-to-speech.
# Only this API talks to it; the app never does.
AI_SERVICE_URL=http://localhost:8001
# Optional shared secret. If set, put the same value in server/.env as INTERNAL_KEY.
AI_INTERNAL_KEY=
# Script + audio generation can take several minutes on CPU.
AI_TIMEOUT_MS=900000

# Where generated mp3 files are stored (one folder per walk preparation).
AUDIO_DIR=./data/audio

# ----------------------------------------------------------------- Web app --

# The Node API base URL, including the /v1 prefix.
# Set the same variable in the Vercel project for deployed builds.
VITE_API_BASE_URL=http://localhost:8000/v1

# Browser-side Google Maps key for the place autocomplete (Maps JavaScript API + Places API).
# Use a separate key from GOOGLE_MAPS_API_KEY and restrict it to this site's origins,
# because this one is visible in the browser.
VITE_GOOGLE_MAPS_API_KEY=
