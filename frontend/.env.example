# Copy to frontend/.env. The Node API base URL, including the /v1 prefix.
# Set the same variable in the Vercel project for deployed builds.
VITE_API_BASE_URL=http://localhost:8000/v1

# Browser-side Google Maps key for the place autocomplete (Maps JavaScript API + Places API).
# Use a separate key from the backend's and restrict it to this site's origins.
VITE_GOOGLE_MAPS_API_KEY=
